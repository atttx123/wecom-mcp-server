# ===== WeCom Self-Built Application Configuration =====
# Obtain from WeCom Admin Console -> My Company / Self-Built Applications

# Corp ID
WECOM_CORP_ID=

# Self-Built App Secret
WECOM_CORP_SECRET=

# Self-Built App AgentId (number)
WECOM_AGENT_ID=0

# ===== Contacts Sync Secret (Optional, Recommended) =====
# Get from Admin Console -> Management Tools -> Contact Sync -> API Interface Sync.
# When configured, contact tools prioritize this secret for full-directory access,
# bypassing the self-built app's "visible scope" limitation.
# Falls back to the self-built app secret if not configured (reads visible scope only).
WECOM_CONTACTS_SECRET=

# ===== Message Callback (Optional, only needed for "Receive Messages") =====
# Configure in Self-Built App -> Receive Messages -> Set API Reception
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_ENCODING_AES_KEY=

# Local webhook listener port for message callbacks
WECOM_WEBHOOK_PORT=9876

# WeCom API gateway (default is fine)
WECOM_API_BASE=https://qyapi.weixin.qq.com

# ===== Outbound Network Policy =====
# true (default): honor HTTP_PROXY / HTTPS_PROXY environment variables
# false: connect directly, ignoring proxy variables
# Set to false for long-running daemons (supervisord / systemd / docker):
# a daemon inherits the proxy environment of the session that launched it,
# and that proxy (e.g. an IDE sandbox proxy) may die with the session,
# leaving the service permanently unable to reach the WeCom API.
WECOM_API_TRUST_ENV=true

# ===== MCP Service Exposure Mode =====
# transport: stdio (default, single client) | streamable-http (multi-agent) | sse (legacy)
# Only HTTP/SSE mode supports: message reception, file persistence, history query
WECOM_MCP_TRANSPORT=stdio
# HTTP/SSE listen address (effective only when transport != stdio; 0.0.0.0 for public access)
WECOM_MCP_HOST=127.0.0.1
# HTTP/SSE listen port (effective only when transport != stdio)
WECOM_MCP_PORT=8101
# Endpoint: streamable-http -> http://<host>:<port>/mcp ; sse -> http://<host>:<port>/sse

# ===== Message Persistence (Effective only in HTTP/SSE transport mode) =====
# Root directory for local message and file storage (contains wecom_messages.db and files/)
# Received messages are partitioned by calendar year in SQLite;
# media files are saved to files/{year}/{month}/
# Approval data and exports also live under this directory
# (wecom_approvals.db and exports/)
WECOM_DATA_DIR=data

# ===== Approval (Workbench - Approval) =====
# Concurrency for approval detail fetching (default 4).
# WeCom enforces a *global* per-company concurrency cap per API (errcode 45033);
# the quota is shared with any other process using the same app, so keep it low.
# Prerequisite: Admin Console -> App Management -> Approval -> API -> Callable Apps
#   add this self-built app, and grant it the approval data permission
#   (Approval -> API -> Approval Data Permission)
WECOM_APPROVAL_CONCURRENCY=4

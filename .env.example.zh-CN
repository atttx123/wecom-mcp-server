# ===== WeCom (企业微信) 自建应用配置 =====
# 从企业微信管理后台 -> 我的企业 / 自建应用 获取

# 企业 ID (CorpID)
WECOM_CORP_ID=

# 自建应用 Secret
WECOM_CORP_SECRET=

# 自建应用 AgentId (数字)
WECOM_AGENT_ID=0

# ===== 通讯录同步 Secret（可选，推荐配置）=====
# 管理后台 → 管理工具 → 通讯录同步 → API接口同步 中获取。
# 配置后，通讯录相关工具优先使用此 secret，
# 可读取全企业通讯录，不受自建应用"可见范围"限制。
# 未配置时回退使用自建应用 secret（只能读可见范围内的成员）。
WECOM_CONTACTS_SECRET=

# ===== 接收消息回调 (可选，仅在需要 "接收消息" 功能时配置) =====
# 在自建应用 -> 接收消息 -> 设置 API 接收 中配置
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_ENCODING_AES_KEY=

# 接收消息回调本地监听端口
WECOM_WEBHOOK_PORT=9876

# 企业微信 API 网关 (默认即可)
WECOM_API_BASE=https://qyapi.weixin.qq.com

# ===== 出网策略 =====
# true（默认）：遵循 HTTP_PROXY / HTTPS_PROXY 环境变量
# false：忽略代理变量，直接连接
# 常驻守护进程（supervisord / systemd / docker）请设为 false——
# 守护进程继承的是"启动它的那次会话"的代理环境，而该代理
# （例如 IDE 沙箱代理）可能随会话结束而失效，导致服务再也无法访问企业微信 API。
WECOM_API_TRUST_ENV=true

# ===== MCP 服务对外暴露方式 =====
# transport: stdio (默认，单客户端) | streamable-http (多 agent 共用) | sse (旧版)
# 仅 HTTP/SSE 模式支持: 接收消息、文件落盘、历史消息查询
WECOM_MCP_TRANSPORT=stdio
# HTTP/SSE 监听地址 (仅 transport != stdio 时生效；0.0.0.0 对外开放)
WECOM_MCP_HOST=127.0.0.1
# HTTP/SSE 监听端口 (仅 transport != stdio 时生效)
WECOM_MCP_PORT=8101
# 端点: streamable-http -> http://<host>:<port>/mcp ; sse -> http://<host>:<port>/sse

# ===== 消息持久化 (仅 HTTP/SSE transport 模式生效) =====
# 消息与文件本地存储根目录 (含 wecom_messages.db 与 files/)
# 接收到的消息按自然年分表存入 SQLite；媒体文件落盘到 files/{year}/{month}/
# 审批数据与导出文件同样位于该目录下 (wecom_approvals.db 与 exports/)
WECOM_DATA_DIR=data

# ===== 审批（工作台 - 审批）=====
# 审批详情拉取并发数（默认 4）
# 企业微信对「同一企业 + 同一接口」有全局并发限制（errcode 45033），且额度由
# 使用同一应用的其他进程共享，故不宜调大，否则会触发 45033 导致数据静默缺失
# 前置条件：管理后台 → 应用管理 → 审批 → API → 可调用应用 加入本自建应用，
#           并在 审批 → API → 审批数据权限 中授权该应用读取审批数据
WECOM_APPROVAL_CONCURRENCY=4
